# ==========================================
# BlogZone Backend Environment Configuration
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/blogzone?retryWrites=true&w=majority

# JWT Secret for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Google Gemini AI API Configuration (Free tier from Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Cloudinary Storage Configuration (Free tier: https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Production Frontend URL (Allowed for CORS alongside localhost)
FRONTEND_URL=https://your-app.vercel.app
